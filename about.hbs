<html>

<head>
    <meta charset="utf-8">
    <title>Butterfly Speak third-party licenses</title>
    <style>
        @media (prefers-color-scheme: dark) {
            body {
                background: #333;
                color: white;
            }
            a {
                color: skyblue;
            }
        }
        .container {
            font-family: sans-serif;
            max-width: 800px;
            margin: 0 auto;
        }
        .intro {
            text-align: center;
        }
        .licenses-list {
            list-style-type: none;
            margin: 0;
            padding: 0;
        }
        .license-used-by {
            margin-top: -10px;
        }
        .license-text {
            max-height: 200px;
            overflow-y: scroll;
            white-space: pre-wrap;
        }
    </style>
</head>

<body>
    <main class="container">
        <div class="intro">
            <h1>Third Party Licenses</h1>
            <p>This page lists the licenses of the Rust crates and npm packages that Butterfly Speak is built from.</p>
        </div>
    
        <h2>Overview of licenses:</h2>
        <ul class="licenses-overview">
            {{#each overview}}
            <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
            {{/each}}
        </ul>

        <h2>All license text:</h2>
        <ul class="licenses-list">
            {{#each licenses}}
            <li class="license">
                <h3 id="{{id}}">{{name}}</h3>
                <h4>Used by:</h4>
                <ul class="license-used-by">
                    {{#each used_by}}
                    <li><a href="{{#if crate.repository}} {{crate.repository}} {{else}} https://crates.io/crates/{{crate.name}} {{/if}}">{{crate.name}} {{crate.version}}</a></li>
                    {{/each}}
                </ul>
                <pre class="license-text">{{text}}</pre>
            </li>
            {{/each}}
        </ul>

        {{!-- Rows kept by hand from pnpm licenses list --prod --json and relay/package-lock.json; update them when an npm dependency changes. --}}
        <h2>npm packages:</h2>
        <p>npm packages in the interface bundle and the relay.</p>
        <table class="npm-packages">
            <thead>
                <tr><th>Package</th><th>Version</th><th>License</th><th>Used by</th></tr>
            </thead>
            <tbody>
                <tr><td><a href="https://fontsource.org/fonts/inter">@fontsource-variable/inter</a></td><td>5.3.0</td><td>OFL-1.1</td><td>interface (Inter font)</td></tr>
                <tr><td><a href="https://github.com/tauri-apps/tauri">@tauri-apps/api</a></td><td>2.11.1</td><td>Apache-2.0 OR MIT</td><td>interface</td></tr>
                <tr><td><a href="https://github.com/tauri-apps/plugins-workspace">@tauri-apps/plugin-opener</a></td><td>2.5.4</td><td>MIT OR Apache-2.0</td><td>interface</td></tr>
                <tr><td><a href="https://github.com/sveltejs/svelte">svelte</a></td><td>5.56.4</td><td>MIT</td><td>interface (runtime)</td></tr>
                <tr><td><a href="https://github.com/sveltejs/kit">@sveltejs/kit</a></td><td>2.69.1</td><td>MIT</td><td>interface (client runtime)</td></tr>
                <tr><td><a href="https://github.com/sveltejs/devalue">devalue</a></td><td>5.8.1</td><td>MIT</td><td>interface (via @sveltejs/kit)</td></tr>
                <tr><td><a href="https://github.com/lukeed/clsx">clsx</a></td><td>2.1.1</td><td>MIT</td><td>interface (via svelte)</td></tr>
                <tr><td><a href="https://github.com/benmccann/esm-env">esm-env</a></td><td>1.2.2</td><td>MIT</td><td>interface (via svelte)</td></tr>
                <tr><td><a href="https://github.com/panva/jose">jose</a></td><td>5.10.0</td><td>MIT</td><td>relay</td></tr>
            </tbody>
        </table>
