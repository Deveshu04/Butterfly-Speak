{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The settings window. It may call the app commands listed below, listen for and emit events, use its own title bar to minimise, maximise, close and drag the window, toggle the developer tools in debug builds, and open dashboard.sarvam.ai in the browser.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:webview:allow-internal-toggle-devtools",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://dashboard.sarvam.ai/*" }, { "url": "https://dashboard.sarvam.ai" }]
    },
    "allow-get-settings",
    "allow-set-settings",
    "allow-list-models",
    "allow-polish-status",
    "allow-download-model",
    "allow-cancel-download",
    "allow-delete-model",
    "allow-select-model",
    "allow-list-mics",
    "allow-system-info",
    "allow-set-meter",
    "allow-hotkey-capture",
    "allow-ensure-support-models",
    "allow-sarvam-key-status",
    "allow-set-sarvam-key",
    "allow-validate-sarvam-key",
    "allow-custom-endpoint-key-status",
    "allow-set-custom-endpoint-key",
    "allow-check-custom-endpoint",
    "allow-prompt-defaults",
    "allow-preview-prompt",
    "allow-test-prompt",
    "allow-endpoint-test-connection",
    "allow-endpoint-list-models",
    "allow-history-list",
    "allow-history-search",
    "allow-history-delete",
    "allow-history-update-text",
    "allow-history-clear",
    "allow-create-note",
    "allow-get-note",
    "allow-update-note",
    "allow-delete-note",
    "allow-list-notes",
    "allow-search-notes",
    "allow-list-folders",
    "allow-create-folder",
    "allow-rename-folder",
    "allow-delete-folder",
    "allow-list-note-actions",
    "allow-create-note-action",
    "allow-update-note-action",
    "allow-delete-note-action",
    "allow-run-note-action",
    "allow-generate-note-title",
    "allow-export-settings",
    "allow-import-settings",
    "allow-undo-learned-correction",
    "allow-export-note",
    "allow-pick-notes-mirror-dir",
    "allow-rebuild-notes-mirror",
    "allow-persist-resolved-theme",
    "allow-import-pick-files",
    "allow-import-start",
    "allow-import-cancel",
    "allow-import-clear",
    "allow-import-status",
    "allow-update-status",
    "allow-update-check",
    "allow-update-install",
    "allow-cloud-sign-in",
    "allow-cloud-sign-out",
    "allow-cloud-status",
    "allow-cloud-usage",
    "allow-cloud-delete-account"
  ]
}
